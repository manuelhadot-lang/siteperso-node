{
  "name": "siteperso-node",
  "version": "1.0.0",
  "private": true,
  "description": "Site personnel Node.js (Express)",
  "main": "server.js",
  "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "sim:ports": "node scripts/check-sim-ports.mjs",
    "repair-esp32-toolchain": "node scripts/repair-esp32-toolchain.cjs",
    "check-ngspice": "node tools/check-ngspice.cjs",
    "prepare-arduino-bundle": "node scripts/prepare-arduino-bundle.cjs",
    "slim": "node scripts/slim-workspace.cjs",
    "slim:apply": "node scripts/slim-workspace.cjs --apply",
    "simulateur-h": "npm start --prefix SimulateurH",
    "simulateur-h:build": "npm run dist --prefix SimulateurH",
    "simulateur-h:setup": "npm run dist:setup --prefix SimulateurH",
    "docs:simulateur-pdf": "node scripts/generate-simulateur-pdf.mjs",
    "docs:simulateur-source-pdf": "node scripts/generate-simulateur-sources-pdf.mjs",
    "docs:simulateur-presentation-pdf": "node scripts/generate-simulateur-presentation-pdf.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.3",
    "operators": "^1.0.0",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "concat-stream": {
      "readable-stream": "^4.7.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
