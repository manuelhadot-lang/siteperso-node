# Copier en ".env" (non versionné) pour tester la page mot de passe en local.
# Sur Render : définir les mêmes clés dans Environment du service.
#
SITE_ACCESS_PASSWORD=

# SITE_ACCESS_SECRET=chaine-aleatoire-optionnelle

# Le mot de passe n’est demandé qu’une fois à l’entrée du site.
# La session cookie reste valable pour tous les blocs ensuite.
# SITE_ACCESS_LOGOUT_ON_PAGE_UNLOAD n’est plus utilisé.

# Durée du cookie (secondes). Par défaut ~7 jours si non défini.
# Pour un cookie « session navigateur » (fermer le navigateur = mot de passe redemandé) :
# SITE_ACCESS_MAX_AGE_SEC=session

# Accès au simulateur depuis d’autres PC du réseau (sinon le serveur n’écoute que localhost) :
# LISTEN_HOST=0.0.0.0

# Simulateur SPICE (Windows) : ne pas mettre NGSPICE=ngspice — laisser vide pour Simulateur/bin/ngspice_con.exe
# NGSPICE=C:\chemin\vers\siteperso-node-main\Simulateur\bin\ngspice_con.exe
#
# Render / Linux : imposer le repli sources B (sans XSPICE) même si le binaire le supporte :
# FORCE_BSOURCE=1
#
# Arduino (menu Arduino / ESP32 → compilation sketch) :
# ARDUINO_CLI=C:\chemin\vers\arduino-cli.exe
# Puis une fois :
#   arduino-cli core update-index && arduino-cli core install arduino:avr
# Pour ESP32-C3 :
#   arduino-cli core update-index && arduino-cli core install esp32:esp32
# (La première compilation ESP32 peut aussi installer le core automatiquement — plusieurs minutes.)
