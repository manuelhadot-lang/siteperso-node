# Copier vers .env et renseigner les valeurs.

# Token client Mapillary (Dashboard → Developers → Create application)
# https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=

# Exemple d’autres variables du projet :
# PORT=3000
# SITE_ACCESS_PASSWORD=

# Sur Render : répertoire du disque persistant (voir render.yaml).
# En local, laissez vide → les fichiers restent dans le dossier du projet.
# DATA_DIR=/var/data

