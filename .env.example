# Copier en ".env" (non versionné) pour tester la page mot de passe en local.
# Sur Render : définir les mêmes clés dans Environment du service.
#
SITE_ACCESS_PASSWORD=change-moi
# SITE_ACCESS_SECRET=chaine-aleatoire-optionnelle

# Déconnexion automatique à chaque déchargement de page (navigation interne comprise) :
# SITE_ACCESS_LOGOUT_ON_PAGE_UNLOAD=1

# Durée du cookie (secondes). Par défaut ~7 jours si non défini.
# Pour un cookie « session navigateur » (fermer le navigateur = mot de passe redemandé) :
# SITE_ACCESS_MAX_AGE_SEC=session
