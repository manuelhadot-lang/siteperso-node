{
    "name": "CAN",
    "components": [
        {
            "type": "arduino_uno",
            "x": 520,
            "y": 420,
            "label": "UNO1",
            "rotation": 0,
            "state": 0,
            "highVoltage": 5,
            "sketch": "// Définition de la broche analogique utilisée\nconst int brocheAnalogique = A0;\n\nvoid setup() {\n  // Initialisation de la communication série à 9600 bauds\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  // 1. Lecture de la valeur brute (entre 0 et 1023)\n  int valeurBrute = analogRead(brocheAnalogique);\n  \n  // 2. Conversion de la valeur brute en tension (0.0V à 5.0V)\n  // Le CAN (Convertisseur Analogique-Numérique) de l'Arduino Uno a une résolution de 10 bits (2^10 = 1024 valeurs)\n  float tension = valeurBrute * (5.0 / 1023.0);\n  \n  // 3. Affichage des résultats dans le Moniteur Série\n  Serial.print(\"Valeur brute (0-1023) : \");\n  Serial.print(valeurBrute);\n  Serial.print(\"  |  Tension : \");\n  Serial.print(tension);\n  Serial.println(\" V\");\n  \n  // Pause de 500 millisecondes entre chaque mesure pour faciliter la lecture\n  delay(500);\n}",
