            "sketch": "#include <DHT.h>\n#include <Wire.h>\n#include <rgb_lcd.h>\n\nrgb_lcd lcd;\n\n#define DHTPIN 2\n#define DHTTYPE DHT22\n\nDHT dht(DHTPIN, DHTTYPE);\n\nvoid setup() \n{ \n  dht.begin();\n  lcd.begin(16,2);\n  lcd.setRGB(255,0,50);\n  lcd.clear();\n  lcd.print(\"Hello les STI2D\");\n  delay(2000);\n  lcd.clear();\n}\n\nvoid loop() \n{\n  float t = dht.readTemperature();\n  float h = dht.readHumidity();\n  lcd.setCursor(0,0);\n  lcd.print(\"Temp \");\n  lcd.print(t);\n  lcd.print(\" deg\");\n  lcd.setCursor(0,1);\n  lcd.print(\"Humi \");\n  lcd.print(h);\n  lcd.print(\" %\");\n}\n",
